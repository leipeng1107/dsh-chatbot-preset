{
  "name": "dsh-chatbot-preset",
  "version": "1.0.0",
  "description": "A community agent preset for DeepSeek Harness: web search, page fetching, image reading and clarifying questions — with no file or shell access.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "agent-preset",
    "chatbot"
  ],
  "license": "MIT",
  "author": "leipeng1107",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leipeng1107/dsh-chatbot-preset.git"
  },
  "homepage": "https://github.com/leipeng1107/dsh-chatbot-preset#readme",
  "bugs": {
    "url": "https://github.com/leipeng1107/dsh-chatbot-preset/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
